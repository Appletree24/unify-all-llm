{
  "name": "unify-llm",
  "version": "0.1.0",
  "description": "Fan one prompt out to every LLM CLI you subscribe to, then synthesize the best answer.",
  "type": "module",
  "bin": {
    "unify": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p . && tsc -p mobile && node mobile/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "predev": "node mobile/build.mjs",
    "dev": "tsc -p . --watch"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "marked": "18.1.3",
    "qrcode": "1.5.4",
    "quickjs-emscripten-core": "0.32.0",
    "zod": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "typescript": "^5.4.0"
  }
}

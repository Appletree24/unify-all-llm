{
  "name": "unify-llm",
  "version": "0.1.0",
  "description": "Fan one prompt out to every LLM CLI you subscribe to, then synthesize the best answer.",
  "type": "module",
  "bin": {
    "unify": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "tsc -p . --watch"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
